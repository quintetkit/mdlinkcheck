{
  "name": "mdlinkcheck",
  "version": "1.0.0",
  "description": "Find broken relative links in Markdown files.",
  "type": "module",
  "bin": {
    "mdlinkcheck": "./bin/mdlinkcheck.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "markdown",
    "links",
    "link-checker",
    "broken-links",
    "cli",
    "documentation",
    "ci",
    "developer-tools"
  ],
  "homepage": "https://github.com/quintetkit/mdlinkcheck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quintetkit/mdlinkcheck.git"
  },
  "bugs": {
    "url": "https://github.com/quintetkit/mdlinkcheck/issues"
  }
}
